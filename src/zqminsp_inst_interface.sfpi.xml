   <cls:CL_FP_CODING id="o5">
    <CL_FP_INTERFACE_DATA_CHANGED classVersion="1">
     <INTERFACE_DATA href="#o1"/>
    </CL_FP_INTERFACE_DATA_CHANGED>
    <CL_FP_CODING classVersion="1">
     <INPUT_PARAMETERS>
      <FPPARAMETER>QALS</FPPARAMETER>
     </INPUT_PARAMETERS>
     <OUTPUT_PARAMETERS>
      <FPPARAMETER>LOGO_URL</FPPARAMETER>
     </OUTPUT_PARAMETERS>
     <INITIALIZATION>
      <FPCLINE>Data:</FPCLINE>
      <FPCLINE>lv_RFCTYPE  LIKE  RFCDISPLAY-RFCTYPE,</FPCLINE>
      <FPCLINE>lv_SERVICENR  LIKE  RFCDISPLAY-RFCSYSID,</FPCLINE>
      <FPCLINE>lv_SERVER LIKE  RFCDISPLAY-RFCHOST,</FPCLINE>
      <FPCLINE>lv_TRACE  LIKE  RFCDISPLAY-RFCTRACE,</FPCLINE>
      <FPCLINE>lv_LANGUAGE LIKE  RFCDISPLAY-RFCLANG,</FPCLINE>
      <FPCLINE>lv_CLIENT LIKE  RFCDISPLAY-RFCCLIENT,</FPCLINE>
      <FPCLINE>lv_USER LIKE  RFCDISPLAY-RFCALIAS,</FPCLINE>
      <FPCLINE>lv_PASSWORD LIKE  RFCDISPLAY-RFCEXEC,</FPCLINE>
      <FPCLINE>lv_DESCRIPTION  LIKE  RFCDOC-RFCDOC1,</FPCLINE>
      <FPCLINE>lv_PROXY_HOST LIKE  RFCDISPLAY-RFCGWHOST,</FPCLINE>
      <FPCLINE>lv_PROXY_SERVICE  LIKE  RFCDISPLAY-RFCGWSERV,</FPCLINE>
      <FPCLINE>lv_PROXY_USER TYPE  RFCDISPLAY-PROXYUSER,</FPCLINE>
      <FPCLINE>lv_PROXY_PASSWORD TYPE  STRING,</FPCLINE>
      <FPCLINE>lv_SSLAPPLIC  TYPE  RFCDISPLAY-SSLAPPLIC,</FPCLINE>
      <FPCLINE>lv_PATH_PREFIX  TYPE  STRING,</FPCLINE>
      <FPCLINE>lv_DESTLOCK LIKE  RFCDISPLAY-RFCLOCK,</FPCLINE>
      <FPCLINE>lv_AUTHORITY  TYPE  DESTAUTH,</FPCLINE>
      <FPCLINE>lv_SLOGIN LIKE  RFCDISPLAY-RFCSLOGIN,</FPCLINE>
      <FPCLINE>lv_SAMEUSR  LIKE  RFCDISPLAY-RFCSAMEUSR,</FPCLINE>
      <FPCLINE>lv_SSL  LIKE  RFCDISPLAY-RFCSNC,</FPCLINE>
      <FPCLINE>lv_HTTP_TIMEOUT TYPE  I,</FPCLINE>
      <FPCLINE>lv_HTTP_VERSION LIKE  RFCDISPLAY-RFCTYPE,</FPCLINE>
      <FPCLINE>lv_HTTP_COMPRESS  LIKE  RFCDISPLAY-RFCTYPE,</FPCLINE>
      <FPCLINE>lv_COMPRESSREPLY  LIKE  RFCDISPLAY-RFCTYPE,</FPCLINE>
      <FPCLINE>lv_COOKIE_ACCEPT  LIKE  RFCDISPLAY-RFCTYPE,</FPCLINE>
      <FPCLINE>lv_SSO_TICKET TYPE  RFCDISPLAY-RFCTSYSOPT,</FPCLINE>
      <FPCLINE>lv_CATEGORY TYPE  RFCDISPLAY-RFCCATEGORY.</FPCLINE>
      <FPCLINE/>
      <FPCLINE>****************************************************</FPCLINE>
      <FPCLINE>* Create logo url string</FPCLINE>
      <FPCLINE>****************************************************</FPCLINE>
      <FPCLINE>CALL FUNCTION &apos;RFC_READ_HTTP_DESTINATION&apos;</FPCLINE>
      <FPCLINE>  EXPORTING</FPCLINE>
      <FPCLINE>    DESTINATION                   = &apos;ADS&apos;</FPCLINE>
      <FPCLINE>    AUTHORITY_CHECK               = &apos; &apos;</FPCLINE>
      <FPCLINE>    BYPASS_BUF                    = &apos;X&apos;</FPCLINE>
      <FPCLINE>  IMPORTING</FPCLINE>
      <FPCLINE>    RFCTYPE                       = lv_RFCTYPE</FPCLINE>
      <FPCLINE>    SERVICENR                     = lv_SERVICENR</FPCLINE>
      <FPCLINE>    SERVER                        = lv_SERVER</FPCLINE>
      <FPCLINE>    TRACE                         = lv_TRACE</FPCLINE>
      <FPCLINE>    LANGUAGE                      = lv_LANGUAGE</FPCLINE>
      <FPCLINE>    CLIENT                        = lv_CLIENT</FPCLINE>
      <FPCLINE>    USER                          = lv_USER</FPCLINE>
      <FPCLINE>    PASSWORD                      = lv_PASSWORD</FPCLINE>
      <FPCLINE>    DESCRIPTION                   = lv_DESCRIPTION</FPCLINE>
      <FPCLINE>    PROXY_HOST                    = lv_PROXY_HOST</FPCLINE>
      <FPCLINE>    PROXY_SERVICE                 = lv_PROXY_SERVICE</FPCLINE>
      <FPCLINE>    PROXY_USER                    = lv_PROXY_USER</FPCLINE>
      <FPCLINE>    PROXY_PASSWORD                = lv_PROXY_PASSWORD</FPCLINE>
      <FPCLINE>    SSLAPPLIC                     = lv_SSLAPPLIC</FPCLINE>
      <FPCLINE>    PATH_PREFIX                   = lv_PATH_PREFIX</FPCLINE>
      <FPCLINE>    DESTLOCK                      = lv_DESTLOCK</FPCLINE>
      <FPCLINE>    AUTHORITY                     = lv_AUTHORITY</FPCLINE>
      <FPCLINE>    SLOGIN                        = lv_SLOGIN</FPCLINE>
      <FPCLINE>    SAMEUSR                       = lv_SAMEUSR</FPCLINE>
      <FPCLINE>    SSL                           = lv_SSL</FPCLINE>
      <FPCLINE>    HTTP_TIMEOUT                  = lv_HTTP_TIMEOUT</FPCLINE>
      <FPCLINE>    HTTP_VERSION                  = lv_HTTP_VERSION</FPCLINE>
      <FPCLINE>    HTTP_COMPRESS                 = lv_HTTP_COMPRESS</FPCLINE>
      <FPCLINE>    COMPRESSREPLY                 = lv_COMPRESSREPLY</FPCLINE>
      <FPCLINE>    COOKIE_ACCEPT                 = lv_COOKIE_ACCEPT</FPCLINE>
      <FPCLINE>    SSO_TICKET                    = lv_SSO_TICKET</FPCLINE>
      <FPCLINE>    CATEGORY                      = lv_CATEGORY</FPCLINE>
      <FPCLINE>  EXCEPTIONS</FPCLINE>
      <FPCLINE>    AUTHORITY_NOT_AVAILABLE       = 1</FPCLINE>
      <FPCLINE>    DESTINATION_NOT_EXIST         = 2</FPCLINE>
      <FPCLINE>    INFORMATION_FAILURE           = 3</FPCLINE>
      <FPCLINE>    INTERNAL_FAILURE              = 4</FPCLINE>
      <FPCLINE>    NO_HTTP_DESTINATION           = 5</FPCLINE>
      <FPCLINE>    OTHERS                        = 6</FPCLINE>
      <FPCLINE>          .</FPCLINE>
      <FPCLINE/>
      <FPCLINE>  concatenate &apos;\\&apos; lv_SERVER &apos;\sapmnt\Logo\logo_spv.jpg&apos; into LOGO_URL.</FPCLINE>
      <FPCLINE/>
     </INITIALIZATION>
     <FORMS/>
    </CL_FP_CODING>
   </cls:CL_FP_CODING>
