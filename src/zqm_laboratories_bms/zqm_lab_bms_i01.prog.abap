MODULE exit_command INPUT.
  CASE gv_ok_code.
    WHEN 'EXIT'.
      PERFORM dispose.
      LEAVE PROGRAM.
  ENDCASE.
ENDMODULE.                 " EXIT_COMMAND  INPUT
