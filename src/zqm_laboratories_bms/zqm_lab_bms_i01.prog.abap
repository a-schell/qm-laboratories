*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE pai_0300 INPUT.
  CASE gv_ok_code.
    WHEN 'BACK'.
      LEAVE PROGRAM.
    WHEN 'SAVE'.
      PERFORM save.
    WHEN 'HEAD_S' OR 'HEAD_M'.
* Show header data popup
      CALL SCREEN 0400
      STARTING AT 1 1.
    WHEN 'ATTA_S' OR 'ATTA_M'.
      PERFORM show_attachment_popup USING gv_ok_code.
  ENDCASE.
ENDMODULE.                 " PAI_0300  INPUT

